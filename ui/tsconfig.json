{
   "compilerOptions": {
     "allowJs": true,
     "allowSyntheticDefaultImports": true,
     "strictNullChecks": false,
     "lib": [ "es2022", "dom" ],
     "module": "Node16",
     "moduleResolution": "Node16",
     "noEmitOnError": true,
     "outDir": "./src/dist",
     "rootDir": "./src",
     "target": "es2022",
     "typeRoots": [
         "node_modules/@types"
     ]
   },
   "include": [
     "src"
   ],
   "exclude": [
     "./node_modules"
   ]
 }